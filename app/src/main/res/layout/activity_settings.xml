<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/settings_map" />

            <Switch
                android:id="@+id/sw_dark"
                style="@style/SettingRow"
                android:text="@string/setting_dark" />

            <Switch
                android:id="@+id/sw_imperial"
                style="@style/SettingRow"
                android:text="@string/setting_imperial" />

            <Switch
                android:id="@+id/sw_keep_on"
                style="@style/SettingRow"
                android:text="@string/setting_keep_on" />

            <TextView
                style="@style/SectionTitle"
                android:text="@string/settings_data" />

            <TextView
                android:id="@+id/row_clear_history"
                style="@style/SettingRow"
                android:text="@string/clear_history" />

            <TextView
                android:id="@+id/row_clear_favorites"
                style="@style/SettingRow"
                android:text="@string/clear_favorites" />

            <TextView
                style="@style/SectionTitle"
                android:text="@string/settings_info" />

            <TextView
                android:id="@+id/row_privacy"
                style="@style/SettingRow"
                android:text="@string/privacy_title" />

            <TextView
                android:id="@+id/row_about"
                style="@style/SettingRow"
                android:text="@string/about_title" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
